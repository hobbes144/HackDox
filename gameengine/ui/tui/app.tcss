/* HackDox Terminal — TUI stylesheet.
 *
 * Dark hacker aesthetic. Green/cyan on near-black.
 * Severity: yellow (minor) → orange (major) → red (critical).
 */

/* ── Global ──────────────────────────────────────────────────────────── */

Screen {
    background: #0b0e10;
    color: #c8d4e1;
}

.panel {
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #0f1419;
    padding: 0 1;
    margin: 0;
}

.panel:focus-within {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

.panel:focus {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

/* ── Status / tab strip ──────────────────────────────────────────────── */

#status-header {
    /* Two-line strip: player resources/standings on top, page tabs below */
    height: 2;
    background: #11161c;
    color: #7dd3c0;
    padding: 0 1;
}

/* ── Content switcher (page host) ────────────────────────────────────── */

ContentSwitcher {
    height: 1fr;
    overflow: hidden;
}

/* ── Candidate page ──────────────────────────────────────────────────── */

#page-candidate {
    layout: vertical;
    height: 100%;
    overflow: hidden;
}

#candidate-top {
    layout: horizontal;
    height: 36%;
}

#candidate-mid {
    height: 38%;
}

#candidate-bot {
    layout: horizontal;
    height: 26%;
}

#dossier   { width: 40%; }
#chat      { width: 60%; }

#evidence-board {
    width: 50%;
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #0d1117;
    padding: 0 1;
}

#evidence-board:focus {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

/* Verdict buttons (batch-3 follow-up, Nick): fill the other half of the mid
 * row alongside whichever evidence board (#evidence-board / #evidence-c0) is
 * currently showing, so the pair is always reachable by arrow-key focus
 * navigation without stealing space from the board. Horizontal now — the
 * ADMIT/DENY column on the left, NEXT (a second follow-up) as a tall, skinny
 * strip on the right, both filling the panel's full height so NEXT reads as
 * tall as ADMIT+DENY combined without hand-computing a matching size. */
#verdict-panel {
    width: 50%;
    height: 100%;
    /* Invisible border in the page background colour. The panel has no border
     * of its own by design, but the verdict-reveal pulse (end of this file)
     * paints one — reserving the two cells here means the flash only changes a
     * colour, instead of growing a border and shoving ADMIT/DENY sideways
     * every time a verdict lands. */
    border: tall #0b0e10;
}

#verdict-buttons {
    width: 1fr;
    height: 100%;
    align: center middle;
}

#verdict-buttons Button {
    width: 90%;
    height: 1fr;
    margin: 1 2;
    content-align: center middle;
    text-style: bold;
}

#btn-next {
    width: 20%;
    min-width: 8;
    height: 100%;
    margin: 1 1;
    content-align: center middle;
    text-style: bold;
}

#btn-next:disabled {
    text-style: bold dim;
}

/* Arrow-key focus feedback for the verdict row (batch-3 follow-up bugfix,
 * Nick): ADMIT/DENY/NEXT already sit in the same up/down focus chain as the
 * panels (see IntakeScreen.action_focus_next/prev), but before this they had
 * no focus styling of their own — Button's built-in :focus only tweaks
 * text-style, which the bold set two rules up already forces to the same
 * value. Landing on a button while arrow-navigating looked identical to
 * landing on nothing, which read as extra, dead "clicks" between the Chat
 * and Reference panels. A bright outline (doesn't disturb layout the way a
 * border swap would against ADMIT/DENY's own success/error borders) plus a
 * reversed text style matches the #00ff9f focus treatment every other panel
 * already uses. */
#verdict-buttons Button:focus,
#btn-next:focus {
    outline: heavy #00ff9f;
    text-style: bold reverse;
}

#btn-next:disabled:focus {
    outline: none;
    text-style: bold dim;
}

/* Toggleable evidence board on the tool pages (2-5). Hidden until the player
 * presses Tab, then it occupies the left column in place of the condensed
 * dossier/reference sidebar so the tool data on the right stays visible.
 * The Candidate page board (#evidence-board, above) is unaffected. */
.tool-evidence {
    display: none;
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #0d1117;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #3a4a58;
    scrollbar-color-hover: #00ff9f;
    scrollbar-color-active: #00ff9f;
}

.tool-evidence:focus {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

/* Wider than the sidebars they replace so the 25-item board has room to
 * breathe — it is the player's primary point of contact with the game. */
#evidence-gs { width: 34%; }
#evidence-hc, #evidence-lw { width: 36%; }
#evidence-st { width: 32%; }
/* Candidate/Dossier-page editable board shares the mid row 50/50 with the
 * verdict buttons (batch-3 follow-up) rather than filling it. */
#evidence-c0 { width: 50%; }

/* Evidence board embedded in the Rules overlay tab — always visible in-tab. */
.rules-evidence {
    display: block;
    width: 100%;
    height: 100%;
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #0d1117;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #3a4a58;
    scrollbar-color-hover: #00ff9f;
    scrollbar-color-active: #00ff9f;
}

.rules-evidence:focus {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

#overseer-side  { width: 40%; }
#reference-side { width: 60%; }

/* ── Tool pages (shared) ─────────────────────────────────────────────── */

.tool-page {
    layout: horizontal;
    height: 100%;
    overflow: hidden;
}

.tool-left {
    layout: vertical;
    width: 32%;
}

.tool-right {
    width: 68%;
}

/* ── Ghostscan page — 3-column override ─────────────────────────────── */
/* sidebar (28%) | terminal (40%) | breach lists (32%) */

#page-ghostscan #gs-left {
    width: 28%;
}

#terminal-gs {
    width: 40%;
}

#breach-list-panel {
    width: 32%;
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #080c10;
    padding: 0 1;
}

#breach-content {
    width: 100%;
}

/* ── Stegotool page — 3-column override ─────────────────────────────── */
/* sidebar (26%) | findings terminal (34%) | image viewer (40%)          */
/* The image viewer dominates the right side — it is the stamp-minigame  */
/* canvas, not a report panel.                                           */

#page-stegotool #st-left {
    width: 26%;
}

#terminal-st {
    width: 34%;
}

#stego-image-panel {
    width: 40%;
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #05080c;
    padding: 0 1;
    content-align: center middle;
}

#stego-image-content {
    width: 100%;
    content-align: center middle;
}

/* ── Condensed dossiers ──────────────────────────────────────────────── */

#condensed-dossier-gs,
#condensed-dossier-hc,
#condensed-dossier-lw,
#condensed-dossier-st {
    height: 50%;
}

#ref-gs, #ref-hc, #ref-lw, #ref-st {
    height: 50%;
}

#terminal-hc,
#terminal-lw,
#terminal-st {
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #080c10;
    padding: 0 1;
}

/* terminal-gs shares the above style but has explicit width from 3-col override */
#terminal-gs {
    border: tall #3a4a58;
    border-title-color: #7dd3c0;
    border-title-style: bold;
    background: #080c10;
    padding: 0 1;
}

.terminal-empty { color: #3d4f5e; text-style: italic; }
.terminal-row   { padding: 0 0 1 0; }
.terminal-filtered { color: #c084fc; text-style: italic; }

/* ── Dossier ─────────────────────────────────────────────────────────── */

#dossier .label { color: #6b7785; }
#dossier .value { color: #c8d4e1; }

/* ── Condensed dossier (tool page sidebar) ───────────────────────────── */

.condensed-dossier .label { color: #6b7785; }

/* ── Chat ────────────────────────────────────────────────────────────── */

#chat .ts           { color: #6b7785; }
#chat .line-warm    { color: #c8d4e1; }
#chat .line-neutral { color: #c8d4e1; }
#chat .line-hostile { color: #ff5470; text-style: bold; }
#chat .line-flippant { color: #c084fc; text-style: italic; }
#chat .line-earnest { color: #7dd3c0; }

/* ── Evidence board ──────────────────────────────────────────────────── */

.eb-group   { color: #3d6478; text-style: bold; }
.eb-flagged { color: #ffb454; }
.eb-cursor  { color: #0b0e10; background: #00ff9f; text-style: bold; }
.eb-normal  { color: #c8d4e1; }

/* ── Overseer panel ──────────────────────────────────────────────────── */

#overseer-side {
    border: tall #c084fc;
    border-title-color: #c084fc;
    border-title-style: bold;
    background: #100c18;
    padding: 0 1;
}

.overseer-line   { color: #c8d4e1; text-style: italic; }
.overseer-stats  { color: #6b7785; }
.overseer-stat-v { color: #7dd3c0; }

/* ── Reference panel ─────────────────────────────────────────────────── */

.ref-accept { color: #00ff9f; }
.ref-reject { color: #ff5470; }
.ref-note   { color: #6b7785; text-style: italic; }
.ref-header { color: #7dd3c0; text-style: bold; }

/* ── Severity colours (findings / tool terminals) ────────────────────── */

.sev-minor    { color: #ffd93d; }
.sev-major    { color: #ff8c42; }
.sev-critical { color: #ff5470; text-style: bold; }

/* ── Rulebook ────────────────────────────────────────────────────────── */

#rulebook { width: 30%; }

/* ── Footer ──────────────────────────────────────────────────────────── */

#footer {
    height: 1;
    background: #11161c;
    color: #7dd3c0;
    padding: 0 1;
}

/* ── Command bar ─────────────────────────────────────────────────────── */

#command-bar {
    height: 3;
    background: #040608;
    color: #c8d4e1;
    padding: 0 1;
    border-top: tall #1a4a2a;
}

/* ── Dev / ground-truth panel ────────────────────────────────────────── */

#debug-panel {
    height: auto;
    min-height: 7;
    border: tall #ffb454;
    border-title-color: #ffb454;
    border-title-style: bold;
    background: #130f00;
    padding: 0 1;
    color: #c8d4e1;
}

/* ── Splashes ────────────────────────────────────────────────────────── */

#splash {
    align: center middle;
    height: 1fr;
}

#splash .title    { color: #00ff9f; text-style: bold; }
#splash .subtitle { color: #7dd3c0; }
#splash .hint     { color: #6b7785; margin: 2 0 0 0; }

.screen-title {
    height: 1;
    color: #7dd3c0;
    text-style: bold;
    padding: 0 2;
    margin: 1 0 0 0;
}

.hint {
    color: #6b7785;
    padding: 0 2;
    margin: 1 0;
}

#overseer-panel {
    border: tall #c084fc;
    background: #14101c;
    padding: 1 2;
    margin: 2 4;
    color: #c8d4e1;
}

#overseer-panel .speaker {
    color: #c084fc;
    text-style: bold;
}

#eod-summary {
    border: tall #7dd3c0;
    background: #0f1419;
    padding: 1 2;
    margin: 1 4;
}

#eod-summary .verdict-correct { color: #00ff9f; }
#eod-summary .verdict-wrong   { color: #ff5470; }

/* ── Rules overlay (modal) ───────────────────────────────────────────── */

RulesScreen {
    align: center middle;
}

#rules-modal {
    width: 84%;
    height: 85%;
    background: #0d1117;
    border: double #7dd3c0;
    padding: 1 2;
    layout: vertical;
}

#rules-title {
    color: #7dd3c0;
    text-style: bold;
    height: 1;
    margin: 0 0 1 0;
}

#rules-tabs {
    height: 1fr;
}

#rules-tabs ContentPane {
    background: #080c10;
    padding: 0 1;
}

.rules-section {
    color: #c8d4e1;
    padding: 1 0;
}

#rules-hint {
    height: 1;
    color: #3d4f5e;
    text-align: right;
    margin: 1 0 0 0;
}

/* Tab strip styling */
RulesScreen TabPane {
    background: #080c10;
    padding: 0 1;
}

RulesScreen Tabs {
    background: #0d1117;
    border-bottom: tall #2a3038;
}

RulesScreen Tab {
    color: #6b7785;
}

RulesScreen Tab.-active {
    color: #7dd3c0;
    text-style: bold;
}

/* ── Between-day menu (issue #22) ─────────────────────────────────────── */

#bd-root {
    height: 1fr;
    padding: 1 2;
}
#bd-left {
    width: 55%;
    margin-right: 2;
}
#bd-summary {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
}
#bd-overseer {
    height: 1fr;
    padding: 1 2;
    border: round #2b3a4a;
    background: #0d131a;
}
#bd-overseer .speaker { color: #7dd3c0; margin-bottom: 1; }
#bd-shop {
    width: 45%;
    padding: 1 2;
    overflow-y: auto;
}

/* ── HackDox Credit reveal modal (issue #25) ──────────────────────────── */

CreditRevealScreen {
    align: center middle;
}
#credit-modal {
    width: 74;
    height: auto;
    max-height: 80%;
    padding: 2 3;
    background: #0b0714;
    border: double #c084fc;
}

/* ── Verdict reveal window ────────────────────────────────────────────────
 *
 * The border pulse that fires for 2-4s after a verdict (see
 * IntakeScreen._begin_verdict_reveal). Green = the verdict matched ground
 * truth, red = it did not.
 *
 * THIS BLOCK MUST STAY LAST IN THE FILE. The pulse has to beat the focus
 * rules it competes with — `.panel:focus-within` (class + pseudo) and
 * `#evidence-board:focus` (id + pseudo) — and each selector below is written
 * with matching specificity so the cascade's document-order tie-break is what
 * decides it. Move these rules up and a focused panel will refuse to flash.
 *
 * -bright and -dim are the two halves of the pulse; IntakeScreen alternates
 * the class on a timer rather than animating, because Textual has no border
 * transition and a two-state swap reads as a deliberate strobe anyway.
 */

#dossier.vf-ok-bright,
#chat.vf-ok-bright,
#evidence-board.vf-ok-bright,
#evidence-c0.vf-ok-bright,
#verdict-panel.vf-ok-bright,
#evidence-gs.vf-ok-bright,
#evidence-hc.vf-ok-bright,
#evidence-lw.vf-ok-bright,
#evidence-st.vf-ok-bright {
    border: tall #00ff9f;
    border-title-color: #00ff9f;
}

#dossier.vf-ok-dim,
#chat.vf-ok-dim,
#evidence-board.vf-ok-dim,
#evidence-c0.vf-ok-dim,
#verdict-panel.vf-ok-dim,
#evidence-gs.vf-ok-dim,
#evidence-hc.vf-ok-dim,
#evidence-lw.vf-ok-dim,
#evidence-st.vf-ok-dim {
    border: tall #14503a;
    border-title-color: #14503a;
}

#dossier.vf-bad-bright,
#chat.vf-bad-bright,
#evidence-board.vf-bad-bright,
#evidence-c0.vf-bad-bright,
#verdict-panel.vf-bad-bright,
#evidence-gs.vf-bad-bright,
#evidence-hc.vf-bad-bright,
#evidence-lw.vf-bad-bright,
#evidence-st.vf-bad-bright {
    border: tall #ff5470;
    border-title-color: #ff5470;
}

#dossier.vf-bad-dim,
#chat.vf-bad-dim,
#evidence-board.vf-bad-dim,
#evidence-c0.vf-bad-dim,
#verdict-panel.vf-bad-dim,
#evidence-gs.vf-bad-dim,
#evidence-hc.vf-bad-dim,
#evidence-lw.vf-bad-dim,
#evidence-st.vf-bad-dim {
    border: tall #5c1f2b;
    border-title-color: #5c1f2b;
}
